          currentSrc={siteImages.earringsImg}
          onUpload={(url) => updateSiteImage("earringsImg", url)}
        />
        <ImageUploadCard
          label="ETHNIC WEAR SECTION"
          currentSrc={siteImages.ethnicImg}
